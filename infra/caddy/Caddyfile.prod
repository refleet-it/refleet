{
	admin off
	http_port 8080
	https_port 8443

	frankenphp {
		# Must exceed the worker count below: FrankenPHP refuses to start otherwise
		# ("num_threads must be greater than the number of worker threads").
		num_threads {$FRANKENPHP_NUM_THREADS:4}

		# Symfony worker mode for ultra-performance
		worker {
			file /app/public/worker.php
			num {$FRANKENPHP_WORKERS:2}
			env APP_RUNTIME Runtime\FrankenPhpSymfony\Runtime
			# Restart workers after N requests to prevent memory leaks
			# MAX_REQUESTS is a FrankenPHP env var, not a Caddyfile directive
			env MAX_REQUESTS {$FRANKENPHP_MAX_REQUESTS:1000}
		}
	}

	servers {
		protocols h1 h2
	}
}

# Per-context container: serves only its own /api/* (whatever this APP_ID's kernel actually
# routes — see docs/adr/0001-multiple-kernels.md), /internal/* and (on backend-file only)
# /uploads/*. Never reached directly by a browser; caddy-gateway
# (infra/caddy/Caddyfile.gateway.prod) is the one public entrypoint and routes each path to
# the right container by service DNS name, and other backend-<context> containers reach
# /internal/* here the same way (App\Shared\Infrastructure\Http\InternalApiClient).
:8080 {
	log {
		output stdout
		format json {
			time_format "iso8601"
		}
	}

	handle /api/* {
		root * /app/public
		php_server
	}

	handle /internal/* {
		root * /app/public
		php_server
	}

	handle /uploads/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /app/public
		file_server {
			precompressed br gzip
		}
	}

	# Email assets (templates/notifications/email/_base.html.twig links the logo by APP_URL);
	# baked into every image, the gateway round-robins them across all contexts.
	handle /notifications/* {
		root * /app/public
		file_server
	}
}

# Metrics endpoint (internal only - accessible from monitoring network)
:9253 {
	metrics

	handle /api/metrics {
		root * /app/public
		php_server
	}
}
