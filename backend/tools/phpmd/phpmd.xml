<?xml version="1.0"?>
<ruleset name="Refleet PHPMD Ruleset"
         xmlns="http://pmd.sf.net/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://pmd.sf.net/ruleset/1.0.0 http://pmd.sf.net/ruleset_xml_schema.xsd"
         xsi:noNamespaceSchemaLocation="http://pmd.sf.net/ruleset_xml_schema.xsd">
    <description>PHPMD rules for Refleet backend</description>

    <!-- Clean Code Rules -->
    <rule ref="rulesets/cleancode.xml">
        <exclude name="StaticAccess"/>
        <exclude name="ElseExpression"/>
        <exclude name="BooleanArgumentFlag"/>
        <exclude name="MissingImport"/>
    </rule>

    <!-- Code Size Rules (overridden rules excluded here and re-added below with custom thresholds) -->
    <rule ref="rulesets/codesize.xml">
        <exclude name="TooManyPublicMethods"/>
        <exclude name="ExcessiveClassComplexity"/>
        <exclude name="ExcessiveMethodLength"/>
        <exclude name="ExcessiveParameterList"/>
        <exclude name="TooManyFields"/>
        <exclude name="TooManyMethods"/>
    </rule>

    <!-- Controversial Rules -->
    <rule ref="rulesets/controversial.xml">
        <exclude name="Superglobals"/>
    </rule>

    <!-- Design Rules -->
    <rule ref="rulesets/design.xml">
        <exclude name="CouplingBetweenObjects"/>
        <exclude name="NumberOfChildren"/>
    </rule>

    <!-- Naming Rules -->
    <rule ref="rulesets/naming.xml">
        <exclude name="ShortVariable"/>
        <exclude name="LongVariable"/>
        <exclude name="LongClassName"/>
        <exclude name="ShortMethodName"/>
        <exclude name="ShortClassName"/>
    </rule>

    <!-- Application layer rules -->
    <rule name="ApplicationLayerClassLength"
          message="The class {0} has {1} lines, exceeding the Application layer limit of {2}."
          class="Refleet\PHPMD\Rule\ApplicationLayerClassLength">
        <description>Classes in the Application layer should not exceed 500 lines.</description>
        <priority>3</priority>
        <properties>
            <property name="minimum" value="500" description="Maximum allowed lines for Application layer classes."/>
        </properties>
    </rule>

    <!-- Custom thresholds for code size rules. Half of PHPMD's default: a method past 50 lines
         in this codebase is invariably a handler that should be split. -->
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="minimum" value="50"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <property name="minimum" value="20"/>
        </properties>
    </rule>

    <rule ref="rulesets/codesize.xml/TooManyFields">
        <properties>
            <property name="maxfields" value="20"/>
        </properties>
    </rule>

    <!--
        Default threshold assumes get*/set* naming; this codebase's aggregates use
        fluent accessors (e.g. headline()) instead, so PHPMD doesn't recognize them
        as getters and counts every one of them. Raised to fit rich config aggregates
        without disabling the check.
    -->
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties>
            <property name="maxmethods" value="30"/>
        </properties>
    </rule>

    <!-- Same fluent-accessor reasoning as TooManyMethods above; the largest current
         aggregate (ShiftTarget) has 27 public methods. -->
    <rule ref="rulesets/codesize.xml/TooManyPublicMethods">
        <properties>
            <property name="maxmethods" value="30"/>
        </properties>
    </rule>

    <!-- Default threshold (50) flags classes that are legitimately branch-heavy rather
         than badly designed: the local file storage service wrapping filesystem error
         handling (58), the GitLab API client (56) and the shared cursor-pagination query
         base class (52). Raised instead of disabling the check. -->
    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity">
        <properties>
            <property name="maximum" value="60"/>
        </properties>
    </rule>

    <!-- Default threshold (13) flags 18 classes, mostly Application command handlers with
         several explicit constructor-injected dependencies (repositories, services, each
         Value Object type-hinted) and aggregates with many Value Object collaborators
         (Account, Shift) - the natural shape of this codebase's DDD style, not accidental
         complexity. Raised just above the current worst offender (Account, 21) instead of
         disabling the check. -->
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="22"/>
        </properties>
    </rule>
</ruleset>
