# Local development defaults for the Symfony app (dev env, run inside docker compose).
# Copy this file to .env before running `make init`:
#   cp .env.dist .env
# .env is gitignored — values below are safe local-dev placeholders, not real secrets.
# Most of these are also injected by compose.override.yml; they're duplicated here
# because Symfony's Dotenv requires /app/.env to exist, and some vars (mailer "from",
# Google OAuth, trusted hosts) aren't passed through docker compose at all.

APP_ENV=dev
# Which application under app/ this process serves. Contexts are being extracted one at
# a time; "monolith" registers all of them — see docs/adr/0001-multiple-kernels.md.
APP_ID=monolith
APP_SECRET=dev-secret-change-me
APP_URL=http://localhost
API_BASE_URL=http://localhost/api
DATABASE_URL="postgresql://refleet:password@database:5432/refleet_db?serverVersion=16&charset=utf8"
TRUSTED_HOSTS=^(localhost|backend(-[a-z]+)?|caddy-gateway|127\.0\.0\.1|.*\.refleet\.local)$
TRUSTED_PROXIES=127.0.0.1
FRONTEND_URL=http://localhost:4200
CORS_ALLOW_ORIGIN=http://localhost:4200
MAILER_DSN=smtp://mail:1025
MAILER_FROM_EMAIL=noreply@refleet.localhost
MAILER_FROM_NAME=Refleet
# The address this instance publishes: shown in the help dialog, in the email footer, and used
# as reply-to. Empty means it publishes none, and those disappear rather than pointing at
# somebody else. TERMS_URL is the same for a legal page.
SUPPORT_EMAIL=
TERMS_URL=
ALLOW_SIGNUP=true
MESSENGER_TRANSPORT_DSN=doctrine://default
# RSA keypair for JWT signing: identity signs with JWT_PRIVATE_KEY, every context (including
# identity itself) verifies with JWT_PUBLIC_KEY only — see LcobucciTokenGenerator and
# JwtAuthenticator. Both are base64-encoded PEM and deliberately empty here: `make init` (or
# `make jwt-keys`) generates a local pair into backend/.env, so no private key is ever committed.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Shared secret for container-to-container calls under /internal (InternalTokenAuthenticator),
# e.g. RunnerDirectoryInterface's HTTP adapter calling the runner context — see
# docs/adr/0001-multiple-kernels.md. Never reachable from a public domain; only meaningful once
# contexts run as separate containers, but every app reads it regardless of topology.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me-32b
# Base URL for each owning context's /internal endpoints, read by the HTTP-backed adapters
# for the Shared\Domain\Service ports that context implements. All point at the same
# "backend" container today because every context still runs there together; Phase 5 of
# docs/adr/0001-multiple-kernels.md repoints each at its own container once they're split.
IDENTITY_INTERNAL_URL=http://backend
ORGANIZATION_INTERNAL_URL=http://backend
RUNNER_INTERNAL_URL=http://backend
PROJECT_INTERNAL_URL=http://backend
QUALIFICATION_INTERNAL_URL=http://backend
NOTIFICATION_INTERNAL_URL=http://backend
PROFILER_ENABLED=true


# --- Google OAuth ---
GOOGLE_CLIENT_ID=dev-google-client-id
GOOGLE_CLIENT_SECRET=dev-google-client-secret

# --- GitLab connection (encrypts stored access tokens at rest) ---
# Generate with: php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
GITLAB_TOKEN_ENCRYPTION_KEY=x27erUrkB7/nim1v2pYrpMIkHUHnW1LUdn1BVGVquZI=
# gitlab.com OAuth application (Applications → "Group owned" or instance-wide). Leave empty to
# offer only the pasted-token flow; the redirect URI is FRONTEND_URL + /dashboard/settings/gitlab/callback.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
