<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Refleet{% endblock %}</title>
    <style>
        :root { color-scheme: light dark; supported-color-schemes: light dark; }
        @media (prefers-color-scheme: dark) {
            body, .bg-page { background:#0b0b0c !important; }
            .card { background:#151617 !important; }
            .text { color:#e9e9ea !important; }
            .muted { color:#b3b3b6 !important; }
            .divider { border-color:#2a2b2d !important; }
        }
        @media screen and (max-width:600px){
            .container{ width:100% !important; }
            .px{ padding-left:16px !important; padding-right:16px !important; }
            .hero-img img{ height:auto !important; }
        }
        a[x-apple-data-detectors]{ color:inherit !important; text-decoration:none !important; }
        .btn:hover{ filter:brightness(0.92); }
    </style>
</head>
<body style="margin:0; padding:0; background:#f5f6f8;" class="bg-page">
<div style="display:none; max-height:0; overflow:hidden; opacity:0;">
    {% block preview %}{% endblock %}
</div>

<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="background:#f5f6f8;" class="bg-page">
    <tr>
        <td align="center" style="padding:32px 12px;">
            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="600" class="container" style="width:600px; max-width:600px;">
                <tr>
                    <td align="left" class="px">
                        <table role="presentation" width="100%">
                            <tr>
                                <td align="left" style="padding:12px 8px;">
                                    <a href="{{ app_url }}" target="_blank" rel="noopener" style="text-decoration:none;">
                                        <img src="{{ app_url }}/notifications/logo.svg" width="185" height="64" alt="Refleet" style="display:block; border:0; outline:none; text-decoration:none;">
                                    </a>
                                </td>
                                <td align="right" style="padding:12px 8px;">
                                    <span style="font:500 13px/1.2 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#6b7280;" class="muted">English</span>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>

                <tr>
                    <td class="px" style="padding:0 12px;">
                        <table role="presentation" width="100%" class="card" style="border-radius:16px; background:#ffffff;">
                            {% block hero %}{% endblock %}

                            <tr>
                                <td style="padding:28px 28px 8px 28px;">
                                    {% block heading %}{% endblock %}
                                </td>
                            </tr>

                            {% block content %}{% endblock %}

                        </table>
                    </td>
                </tr>

                <tr>
                    <td class="px" align="center" style="padding:18px 12px 0 12px;">
                        <p style="margin:0; font:500 12px/1.4 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#6b7280;" class="muted">
                            {% if support_email %}Questions? Email us: <a href="mailto:{{ support_email }}" style="color:#6b7280; text-decoration:underline;">{{ support_email }}</a>{% endif %}
                        </p>
                    </td>
                </tr>

                <tr>
                    <td class="px" align="center" style="padding:10px 12px 32px 12px;">
                        <p style="margin:8px 0 0 0; font:400 11px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#9ca3af;" class="muted">
                            © {{ "now"|date("Y") }} Refleet. All rights reserved
                        </p>
                    </td>
                </tr>

            </table>
        </td>
    </tr>
</table>
</body>
</html>
