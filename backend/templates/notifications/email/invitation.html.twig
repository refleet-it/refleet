{% extends 'notifications/email/_base.html.twig' %}

{% block title %}You're invited to {{ organizationName }} - Refleet{% endblock %}

{% block preview %}You have been invited to join {{ organizationName }} on Refleet.{% endblock %}

{% block hero %}
<tr>
    <td style="padding:0; border-radius:16px 16px 0 0; overflow:hidden;">
        <div class="hero-img" style="line-height:0;">
            <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?q=80&w=1600&auto=format&fit=crop" width="600" height="260" alt="" style="display:block; width:100%; height:260px; object-fit:cover; border:0;">
        </div>
    </td>
</tr>
{% endblock %}

{% block heading %}
<h1 style="margin:0; font:700 24px/1.25 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#111827;" class="text">
    You're invited to join {{ organizationName }}
</h1>
<p style="margin:12px 0 0 0; font:400 15px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#374151;" class="text">
    You have been invited to join {{ organizationName }} on Refleet. Click the button below to accept the invitation.
</p>
{% endblock %}

{% block content %}
<tr>
    <td style="padding:20px 28px 8px 28px;">
        <!--[if mso]>
        <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{ acceptUrl }}" style="height:48px;v-text-anchor:middle;width:100%;" arcsize="12%" stroke="f" fillcolor="#171717">
          <w:anchorlock/>
          <center style="color:#ffffff;font-family:Segoe UI, Helvetica, Arial, sans-serif;font-size:16px;font-weight:700;">
            Accept invitation
          </center>
        </v:roundrect>
        <![endif]-->
        <!--[if !mso]><!-- -->
        <a href="{{ acceptUrl }}" class="btn" style="display:inline-block; width:100%; text-align:center; background:#171717; color:#fff; text-decoration:none; font:700 16px/48px -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; border-radius:8px;">
            Accept invitation
        </a>
        <!--<![endif]-->
    </td>
</tr>

<tr>
    <td style="padding:8px 28px 0 28px;">
        <p style="margin:0; font:400 13px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#6b7280;" class="muted">
            This invitation will expire in 7 days. If you were not expecting this invitation, you can safely ignore this message.
        </p>
    </td>
</tr>

<tr>
    <td style="padding:24px 28px;">
        <hr class="divider" style="border:0; border-top:1px solid #e5e7eb; margin:0;">
    </td>
</tr>

<tr>
    <td style="padding:0 28px 28px 28px;">
        <p style="margin:0 0 8px 0; font:700 14px/1.3 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#111827;" class="text">
            Button not working?
        </p>
        <p style="margin:0; font:400 13px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#6b7280; word-break:break-all;" class="muted">
            Copy and paste the link below into your browser:<br>
            <a href="{{ acceptUrl }}" style="color:#6b7280; text-decoration:underline;">{{ acceptUrl }}</a>
        </p>
    </td>
</tr>
{% endblock %}
