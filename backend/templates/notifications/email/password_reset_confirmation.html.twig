{% extends 'notifications/email/_base.html.twig' %}

{% block title %}Password Changed - Refleet{% endblock %}

{% block preview %}Your Refleet account password has been changed successfully.{% endblock %}

{% block hero %}
<tr>
    <td style="padding:0; border-radius:16px 16px 0 0; overflow:hidden;">
        <div class="hero-img" style="line-height:0;">
            <img src="https://images.unsplash.com/photo-1698162320350-13ca8c9503ac?q=80&w=1600&auto=format&fit=crop" width="600" height="260" alt="" style="display:block; width:100%; height:260px; object-fit:cover; border:0;">
        </div>
    </td>
</tr>
{% endblock %}

{% block heading %}
<h1 style="margin:0; font:700 24px/1.25 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#111827;" class="text">
    Your password has been changed
</h1>
<p style="margin:12px 0 0 0; font:400 15px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#374151;" class="text">
    This is a confirmation that the password for your Refleet account has been changed successfully. You can now log in using your new password.
</p>
{% endblock %}

{% block content %}
<tr>
    <td style="padding:20px 28px 8px 28px;">
        <a href="{{ frontendUrl }}/login" class="btn" style="display:inline-block; width:100%; text-align:center; background:#171717; color:#fff; text-decoration:none; font:700 16px/48px -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; border-radius:8px;">
            Log in to Refleet
        </a>
    </td>
</tr>

<tr>
    <td style="padding:8px 28px 0 28px;">
        <p style="margin:0; font:400 13px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#6b7280;" class="muted">
            If you did not change your password, please contact our support team immediately to secure your account.
        </p>
    </td>
</tr>

<tr>
    <td style="padding:22px 28px 28px 28px;">
        <p style="margin:0; font:400 14px/1.6 -apple-system,BlinkMacSystemFont,Segoe UI,Roboto,Inter,Helvetica,Arial,sans-serif; color:#6b7280;" class="muted">
            This message was sent automatically to confirm a password change on your account.
        </p>
    </td>
</tr>
{% endblock %}
