# Local defaults for the auto-detecting agent fleet runner (runner/agent/compose.yml).
# Copy this file to .env before running `docker compose up`:
#   cp .env.dist .env
#
# The image bundles both claude and kiro-cli, but you only need credentials for the
# agent(s) you actually want to use — a job whose engine isn't installed/authenticated
# on this runner simply never gets claimed by it (see agent/src/detect.ts).

# --- Claude Code authentication (required to use the claude engine) ---
ANTHROPIC_API_KEY=

# --- Kiro authentication (required to use the kiro engine) ---
# Documented for kiro-cli's --no-interactive headless mode (requires a Kiro Pro/Pro+/
# Pro Max/Power subscription) — see https://kiro.dev/docs/cli/headless/. Not confirmed
# to also cover `kiro-cli acp` (the mode this runner actually uses); if the kiro engine
# fails to authenticate, check the ACP docs (https://kiro.dev/docs/cli/acp/) for a
# separate auth step first.
KIRO_API_KEY=

# --- Runner identity (free-text prefix; each detected engine registers its own
# Runner named "<RUNNER_NAME>-<engine>", e.g. local-runner-01-claude) ---
RUNNER_NAME=local-runner-01

# --- Refleet backend integration (required — this runner only supports fleet mode) ---
# REFLEET_API_URL is the API base, e.g. http://localhost/api.
# REFLEET_API_KEY is a token created via POST /identity/api-keys (Bearer <token>).
# For local/CLI use, `refleet-runner login` does both interactively and saves the
# result to ~/.config/refleet/runner.json — leave these two blank in that case, they're
# only needed here for Docker/automatic/cloud deployments where there's no one to log
# in interactively.
REFLEET_API_URL=
REFLEET_API_KEY=
HEARTBEAT_INTERVAL_SECONDS=30
POLL_INTERVAL_SECONDS=10

# --- GitLab checkout (fleet mode) ---
# No GitLab config needed here: before each job the runner fetches the base URL and a
# Personal Access Token for the job's organization from the Refleet backend (set up once
# via Settings > Connect GitLab), and sends the token as a PRIVATE-TOKEN header — never
# persisted into the cached checkout's git config.
# Per-project checkouts are cached under this directory and reused (fetch + hard
# reset) across jobs instead of a fresh clone every time. Bounded by total size, not
# by project count — least-recently-used checkouts are evicted once the cap is hit.
WORKSPACE_CACHE_DIR=/workspace/cache
WORKSPACE_CACHE_MAX_SIZE_MB=5120

# --- Claude Code parameters (all optional) ---
# Model override, e.g. claude-sonnet-5
CLAUDE_MODEL=
# One of: default, acceptEdits, bypassPermissions, plan
CLAUDE_PERMISSION_MODE=
# Comma-separated tool patterns, e.g. "Bash(git:*),Edit,Write"
CLAUDE_ALLOWED_TOOLS=
# Overrides for "qualification" jobs specifically (the fit/no-fit decision that must
# not modify the checkout). Left unset, qualification falls back to CLAUDE_MODEL and
# to a read-only "Read,Grep,Glob" tool set instead of CLAUDE_ALLOWED_TOOLS, so a
# trivial yes/no check doesn't default to full Edit/Write/Bash access. Set
# CLAUDE_QUALIFICATION_MODEL to a cheaper/faster model (e.g.
# claude-haiku-4-5-20251001) to cut cost further; "change" jobs are unaffected.
CLAUDE_QUALIFICATION_MODEL=
CLAUDE_QUALIFICATION_ALLOWED_TOOLS=
# Additional directories Claude Code may access, comma-separated
CLAUDE_ADD_DIRS=
# Bypasses all permission prompts. Defaults to true because this runs headless — there
# is no one to interactively approve Edit/Write/Bash, so without this the agent can
# only report that it lacks permission instead of acting. Safe here because the
# container/checkout are isolated and disposable; set to false only if you also supply
# CLAUDE_ALLOWED_TOOLS scoped to what the job actually needs.
CLAUDE_SKIP_PERMISSIONS=true
# Raw passthrough of extra `claude` CLI flags, space-separated
CLAUDE_EXTRA_ARGS=

# --- Auto-detection overrides (optional) ---
# Pin an explicit executable path/command instead of the default PATH lookup.
REFLEET_CLAUDE_PATH=
REFLEET_KIRO_PATH=
