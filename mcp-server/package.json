{
  "name": "refleet-mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server exposing a whitelisted set of dev-workflow tools (Makefile targets, docker compose lifecycle) for the refleet monorepo.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "refleet-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && cd dist && node --test",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
