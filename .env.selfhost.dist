# Configuration for a self-hosted Refleet.
#
#   cp .env.selfhost.dist .env
#   make selfhost
#
# `make selfhost` fills in every generated secret below that is still empty, brings the stack
# up and offers to create the first account. Everything it cannot invent — the hostname, how
# mail leaves the machine — is yours to fill in first.

# --- Required ---

# The hostname this instance answers on. Caddy obtains a certificate for it automatically,
# so it must already resolve to this machine. Use `localhost` to try things out locally;
# Caddy then issues a certificate from its own CA and your browser will warn about it once.
APP_DOMAIN=refleet.example.com

# How notification mail leaves the machine. Anything Symfony Mailer understands works:
#   smtp://user:pass@smtp.example.com:587
#   sendgrid+smtp://apikey@default
# Without a working transport, invitations and password resets are written to the log and
# never arrive.
MAILER_DSN=
MAILER_FROM_EMAIL=refleet@refleet.example.com
MAILER_FROM_NAME=Refleet

# --- Generated: leave empty and `make selfhost` writes them once ---

APP_SECRET=
# RSA keypair, base64-encoded PEM. Refleet signs session tokens with the private half.
# Replacing it signs everyone out; losing it is not recoverable from a database backup.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Encrypts the GitLab tokens at rest. Replacing it makes every stored connection
# undecryptable and they have to be reconnected.
GITLAB_TOKEN_ENCRYPTION_KEY=
DB_USER_PASSWORD=

# --- Optional ---

TZ=UTC
IMAGE_TAG=latest
DB_NAME=refleet
DB_USER=refleet

# Where Let's Encrypt sends certificate expiry warnings. Defaults to admin@<APP_DOMAIN>,
# which is only useful if somebody reads it.
ACME_EMAIL=

# Shown in the application's help dialog and the email footer, and used as reply-to. Empty
# hides it rather than pointing your users somewhere that is not you.
SUPPORT_EMAIL=

# Your terms of service and privacy policy, if you publish any. Empty leaves the consent at
# registration as plain text with nothing to click.
TERMS_URL=

# `true` lets anyone who can reach this instance create an account. The default keeps it
# invitation-only: `make selfhost` creates the first account, and everyone else is invited
# from inside the application.
ALLOW_SIGNUP=false

# Sign-in with Google, if you register an OAuth client for it. Redirect URI:
# https://<APP_DOMAIN>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connecting GitLab through OAuth rather than a pasted access token. Point the base URL at
# your own GitLab if it is self-managed. Redirect URI:
# https://<APP_DOMAIN>/dashboard/settings/gitlab/callback — scope `api`, confidential.
GITLAB_OAUTH_BASE_URL=https://gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=

# --- Runner (only for `--profile runner`) ---
#
# A runner does not have to run on this machine; it only needs to reach the API. See
# docs/runner/installation.md. Create the API key under Settings > Developer.
REFLEET_API_KEY=
RUNNER_NAME=selfhost-runner
ANTHROPIC_API_KEY=
KIRO_API_KEY=
