# Local development defaults for docker compose (compose.yml + compose.override.yml).
# Copy this file to .env before running `make init` / `docker compose up`:
#   cp .env.dist .env
# .env is gitignored — values below are safe local-dev placeholders, not real secrets.

# --- Backend / Symfony ---
APP_SECRET=dev-secret-change-me
# RSA keypair for JWT signing: identity signs with JWT_PRIVATE_KEY, every context verifies
# with JWT_PUBLIC_KEY only — see backend/.env.dist for which container gets which. Both are
# base64-encoded PEM and deliberately empty here: `make init` (or `make jwt-keys`) generates a
# local pair into .env, so no private key is ever committed.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Shared secret for container-to-container calls under /internal — see backend/.env.dist.
INTERNAL_SERVICE_TOKEN=dev-internal-service-token-change-me-32b
DATABASE_URL=postgresql://refleet:password@database:5432/refleet_db?serverVersion=16&charset=utf8
MESSENGER_TRANSPORT_DSN=doctrine://default

# --- PostgreSQL ---
DB_NAME=refleet_db
DB_USER=refleet
DB_USER_PASSWORD=password


# --- Fleet runner (compose.override.yml "runner" service) ---
# ANTHROPIC_API_KEY / KIRO_API_KEY are required only for whichever engine(s) you
# actually want it to auto-detect and register — see runner/agent/src/detect.ts and
# runner/agent/src/fleet/loop.ts.
ANTHROPIC_API_KEY=
KIRO_API_KEY=
RUNNER_NAME=local-runner-01
# Fixed local-dev token seeded by FleetStory fixtures (ApiKeyFactory::TEST_TOKEN) for the
# owner@acme-robotics.test account — stays valid across `make init` / `db-recreate`
# reloads, no need to regenerate it via Settings > Developer. It's an org-scoped API
# key, not a per-runner credential.
REFLEET_API_KEY=ib_local_dev_fixture_static_runner_token_0001
# GitLab credentials are no longer set here: the runner fetches the base URL and access
# token for the job's organization from the backend (Settings > Connect GitLab in the UI).
