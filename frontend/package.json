{
  "name": "front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "docs": "node scripts/build-docs.mjs",
    "docs:watch": "node scripts/build-docs.mjs --watch",
    "prebuild": "npm run docs",
    "build:dev": "ng build --configuration=dev",
    "prebuild:dev": "npm run docs",
    "build:prod": "ng build --configuration=production",
    "prebuild:prod": "npm run docs",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "format": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "type-check": "tsc --noEmit",
    "lighthouse": "lhci autorun",
    "optimize-images": "node scripts/optimize-images.mjs",
    "quality": "npm run format:check && npm run lint && npm run type-check",
    "postinstall": "node scripts/patch-angular-platform-server.js"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.23",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/platform-browser": "^21.2.23",
    "@angular/platform-server": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@angular/ssr": "^21.2.21",
    "@ng-icons/core": ">=32.0.0 <34.0.0",
    "@ng-icons/lucide": ">=32.0.0 <34.0.0",
    "@spartan-ng/brain": "^1.2.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.21",
    "@angular-devkit/core": "^21.2.21",
    "@angular-devkit/schematics": "^21.2.21",
    "@angular/build": "^21.2.21",
    "@angular/cli": "^21.2.21",
    "@angular/compiler-cli": "^21.2.23",
    "@lhci/cli": "^0.15.1",
    "@nx/js": "23.1.1",
    "@schematics/angular": "^21.2.20",
    "@spartan-ng/cli": "^1.2.0",
    "@swc/helpers": "~0.5.18",
    "@types/express": "^5.0.6",
    "@typescript-eslint/utils": "^8.58.0",
    "angular-eslint": "22.5.0",
    "autoprefixer": "^10.4.27",
    "baseline-browser-mapping": "^2.10.9",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "jsonc-eslint-parser": "^2.1.0",
    "lighthouse": "^13.0.3",
    "marked": "^18.0.9",
    "ng-packagr": "~21.2.0",
    "postcss": "^8.5.14",
    "prettier": "^3.8.1",
    "sharp": "^0.35.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "vite": "7.3.5",
    "basic-ftp": "6.0.1",
    "rollup": "^4.59.0",
    "immutable": "^5.1.5",
    "less": "^4.8.1",
    "nx": {
      "brace-expansion": "^5.0.9"
    },
    "serialize-javascript": "^7.0.4",
    "tar": "^7.5.11",
    "tmp": ">=0.2.6",
    "uuid": ">=11.1.1",
    "picomatch": "^4.0.4",
    "qs": "^6.16.0",
    "smol-toml": "^1.8.0",
    "lighthouse": "$lighthouse"
  }
}
