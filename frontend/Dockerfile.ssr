FROM node:26-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80 AS builder
ARG BUILD_CMD=build:prod
ARG BUILD_HASH=dev
WORKDIR /app
# Built from the repository root, not frontend/, because scripts/build-docs.mjs renders
# docs/ — which lives at the root so GitLab renders it too — into the pages served at /docs.
COPY frontend/package*.json ./
COPY frontend/scripts/ ./scripts/
RUN npm ci --legacy-peer-deps
COPY frontend/ .
COPY docs/ /docs/
RUN sed -i "s/buildHash: '[^']*'/buildHash: '${BUILD_HASH}'/g" src/environments/environment.prod.ts src/environments/environment.dev.ts
RUN npm run ${BUILD_CMD}

FROM node:26-alpine@sha256:0b36e8c136b94cd4fcf02188228e76c31ad5872eef3fec8cbd2eee500cfd9e80
ARG BUILD_HASH=dev
ENV BUILD_HASH=$BUILD_HASH
ENV NODE_ENV=production
WORKDIR /app
# Official node images already ship a non-root "node" user (uid/gid 1000) - use it
# instead of running the SSR server as root, consistent with the backend container.
COPY --from=builder --chown=node:node /app/dist/front/server ./server
COPY --from=builder --chown=node:node /app/dist/front/browser ./browser
USER node
EXPOSE 4000
CMD ["node", "server/server.mjs"]
